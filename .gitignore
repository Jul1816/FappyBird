# Virtual environments
.venv/
venv/
env/
ENV/

# Python bytecode & cache
__pycache__/
*.py[cod]
*$py.class
*.tmp

# PyInstaller & build artifacts (Bỏ toàn bộ thư mục build, dist, spec và build script)
build/
dist/
*.spec
build_exe.bat

# Cho phép git file game executable
!FlappyBird.exe
!*.exe

# Testing, tasks, docs & cache (chỉ giữ file tối thiểu để chạy game)
tests/
tasks/
docs/
.superpowers/
.pytest_cache/
.coverage
htmlcov/

# Local game runtime & save data
data/

# IDEs & OS files
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
Thumbs.db
desktop.ini
.DS_Store

# Markdown files: ĐẶC BIỆT KHÔNG GIT BẤT KỲ FILE MD NÀO TRỪ README
*.md
**/*.md
!README.md
